{
  "expo": {
    "name": "Terrabovina",
    "slug": "gestao-gado",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/images/icone-app.png",
    "scheme": "gestaogado",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.gestaogado.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-PT",
        "CFBundleLocalizations": [
          "pt-PT",
          "en"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.gestaogado.app",
      "adaptiveIcon": {
        "backgroundColor": "#1B7A48",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon-gado.png",
      "lang": "pt-PT",
      "name": "Terrabovina",
      "shortName": "Terrabovina",
      "description": "Gestão pecuária offline-first para criadores em Portugal.",
      "themeColor": "#0f7d33",
      "backgroundColor": "#1b7a48",
      "display": "standalone",
      "startUrl": "/",
      "orientation": "any"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B7A48",
          "image": "./assets/images/splash-terrabovina.png",
          "imageWidth": 160
        }
      ],
      "expo-font",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#0f7d33",
          "defaultChannel": "alertas"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "A Terrabovina precisa de aceder às suas fotografias para ilustrar a ficha do animal e guardar faturas e guias.",
          "cameraPermission": "A Terrabovina precisa da câmara para fotografar o animal e os documentos da exploração, e para ler os códigos impressos nas caixas de medicamento.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "A Terrabovina precisa da câmara para fotografar o animal e os documentos da exploração, e para ler os códigos impressos nas caixas de medicamento.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "A Terrabovina precisa do microfone para gravar mensagens de voz nas conversas com a sua equipa.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1db860e-ee1e-49fe-8c0d-793304effca4"
      }
    },
    "owner": "otariodoing",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d1db860e-ee1e-49fe-8c0d-793304effca4"
    }
  }
}
